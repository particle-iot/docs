<!-- device-comparison -->
<div class="deviceComparison">
    <div class="deviceComparisonSelects">
        <div class="deviceComparisonSelect">Device 1: <select class="deviceComparisonDevice apiHelperSelect" data-param="d1"></select></div>
        <div class="deviceComparisonSelect">Device 2: <select class="deviceComparisonDevice apiHelperSelect" data-param="d2"></select></div>
        <div class="deviceComparisonSelect">Device 3: <select class="deviceComparisonDevice apiHelperSelect" data-param="d3"></select></div>
        <div class="deviceComparisonSelect"><label><input type="checkbox" class="deviceComparisonCountry" data-param="cc" checked/> Show country compatibility</label></div>
    </div>
    <div class="deviceComparisonTable"></div>
    <div class="deviceComparisonFootnote"><sup>1</sup> On M.2 SoMs this feature is on the base board.</div>
    <div class="deviceComparisonFootnote deviceComparisonFootnoteShared" style="display:none"><sup>2</sup> Wi-Fi and BLE share a single external antenna.</div>
</div>
